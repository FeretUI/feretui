<templates>
  <template id="view-goto-create-button">
    <button
      class="button is-primary"
      hx-get="{{ url }}"
    >
      <span class="icon">
        <i class="ti ti-plus"></i>
      </span>
      <span>Create</span>
    </button>
  </template>
  <template id="view-do-save-button">
    <button
      class="button is-primary"
      type="submit"
    >
      <span class="icon">
        <i class="ti ti-edit"></i>
      </span>
      <span>Save</span>
    </button>
  </template>
  <template id="view-goto-selected-delete-button">
    <button
      class="button is-danger selected-buttons-resource-{{ rcode }}-view-{{ vcode }}"
      hx-post="{{ feretui.base_url }}/action/resource?action=goto_delete"
      disabled="{{ disabled }}"
    >
      <span class="icon">
        <i class="ti ti-trash"></i>
      </span>
      <span>Delete</span>
    </button>
  </template>
  <template id="view-goto-delete-button">
    <button
      class="button is-danger"
      hx-get="{{ url }}"
    >
      <span class="icon">
        <i class="ti ti-trash"></i>
      </span>
      <span>Delete</span>
    </button>
  </template>
  <template id="view-do-delete-button">
    <button
      class="button is-danger"
      type="submit"
    >
      <span class="icon">
        <i class="ti ti-trash"></i>
      </span>
      <span>Delete</span>
    </button>
  </template>
  <template id="view-goto-edit-button">
    <button
      class="button is-primary"
      hx-get="{{ url }}"
    >
      <span class="icon">
        <i class="ti ti-edit"></i>
      </span>
      <span>Edit</span>
    </button>
  </template>
  <template id="view-goto-return-button">
    <button
      class="button is-ghost secondary outline"
      hx-get="{{ url }}"
    >
      <span class="icon">
        <i class="ti ti-arrow-left"></i>
      </span>
      <span>Return</span>
    </button>
  </template>
  <template id="view-goto-cancel-button">
    <button 
      class="button is-ghost secondary outline"
      type="reset"
      onclick="window.history.back()"
    >
      <span class="icon">
        <i class="ti ti-x"></i>
      </span>
      <span>Cancel</span>
    </button>
  </template>
  <template id="view-goto-edit-cancel-button">
    <button 
      class="button is-ghost secondary outline"
      type="reset"
      hx-get="{{ url }}"
    >
      <span class="icon">
        <i class="ti ti-x"></i>
      </span>
      <span>Cancel</span>
    </button>
  </template>
  <template id="view-buttons-header">
    <div class="buttons is-centered is-hidden-print">
      {% for button in header_buttons %}
      {{ button }}
      {% endfor %}
    </div>
  </template>
  <template id="view-pagination">
    <div class="is-hidden-print" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 0.75rem;">
      <div style="flex: 0 0 auto; display: flex; align-items: center; gap: 0.5rem;">
        <include template="view-buttons-header" />
      </div>
      <div style="margin-left: auto;">
        {% if paginations %}
        <nav class="pagination" role="navigation" aria-label="pagination">
          <ul class="pagination-list">
            {% for pagination in paginations %}
            <li>
              {% if pagination == offset %}
              <button class="button pagination-link is-current">
                {{ pagination + 1 }}-{{ [pagination + limit, dataset.total]|min }}
                <span class="is-sr-only">Selected</span>
              </button>
              {% endif %}
              {% if pagination != offset %}
              <button
                class="button pagination-link"
                hx-get="{{ feretui.base_url}}/action/resource?action=pagination&amp;offset={{ pagination }}"
              >
                {{ pagination + 1 }}-{{ [pagination + limit, dataset.total]|min }}
              </button>
              {% endif %}
            </li>
            {% endfor %}
          </ul>
          {% if paginations[0] == offset %}
          <button class="button pagination-previous" disabled>
            <i class="ti ti-chevron-left"></i>
          </button>
          {% endif %}
          {% if paginations[0] != offset %}
          <button
            class="button pagination-previous"
            hx-get="{{ feretui.base_url}}/action/resource?action=pagination&amp;offset={{offset - limit}}"
          >
            <i class="ti ti-chevron-left"></i>
            <span class="is-sr-only">Previous</span>
          </button>
          {% endif %}
          {% if paginations[-1] == offset %}
          <button class="button pagination-next" disabled>
            <i class="ti ti-chevron-right"></i>
          </button>
          {% endif %}
          {% if paginations[-1] != offset %}
          <button
            class="button pagination-next"
            hx-get="{{ feretui.base_url}}/action/resource?action=pagination&amp;offset={{offset + limit}}"
          >
            <i class="ti ti-chevron-right"></i>
            <span class="is-sr-only">Next</span>
          </button>
          {% endif %}
        </nav>
        {% endif %}
        {% if view_switchers %}
        <div class="feretui-view-switcher" role="toolbar" aria-label="View switcher">
          {% for sw in view_switchers %}
          <a href="{{ sw.url }}"
             hx-get="{{ sw.goto_url }}"
             hx-target="#feretui-body"
             hx-swap="innerHTML"
             role="button"
             class="feretui-view-btn {{ 'is-active' if sw.is_active else '' }}"
             aria-current="{{ 'page' if sw.is_active else 'false' }}"
             data-tooltip="{{ sw.label }}"
             data-placement="bottom"
             title="{{ sw.label }}">
            <i class="{{ sw.icon }}"></i>
          </a>
          {% endfor %}
        </div>
        {% endif %}
      </div>
    </div>
  </template>
  <template id="view-multi-header">
    <div class="is-hidden-print feretui-control-panel" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
        <h1 style="margin-bottom: 0;">{{ label }} <small style="font-size: 0.9rem; color: var(--pico-muted-color);">({{ dataset.total }})</small></h1>
        <div class="feretui-search-box" style="position: relative; display: inline-flex; align-items: center;">
          <i class="ti ti-search" style="position: absolute; left: 0.65rem; color: var(--pico-muted-color); pointer-events: none;"></i>
          <input type="search"
                 name="search"
                 value="{{ search_query or '' }}"
                 placeholder="Search..."
                 hx-get="?page=resource&amp;resource={{ rcode }}&amp;view={{ vcode }}"
                 hx-include="closest form"
                 hx-trigger="keyup changed delay:300ms, search"
                 hx-target="#feretui-body"
                 hx-swap="innerHTML"
                 hx-push-url="true"
                 style="padding-left: 2rem; margin-bottom: 0; height: 2rem; font-size: 0.85rem; width: 170px;"
                 class="input is-small feretui-search-input" />
        </div>
        {% if group_by_options %}
        <div class="feretui-group-by-selector" style="display: inline-flex; align-items: center;">
          <select name="group_by"
                  id="group-by-{{ rcode }}"
                  class="select is-small"
                  hx-get="?page=resource&amp;resource={{ rcode }}&amp;view={{ vcode }}"
                  hx-include="closest form"
                  hx-target="#feretui-body"
                  hx-swap="innerHTML"
                  hx-push-url="true"
                  style="height: 2rem; padding: 0.2rem 1.75rem 0.2rem 0.6rem; font-size: 0.85rem; margin-bottom: 0;">
            <option value="">Group by...</option>
            {% for gb_name, gb_label in group_by_options %}
            {% if group_by == gb_name %}
            <option value="{{ gb_name }}" selected="selected">{{ gb_label }}</option>
            {% else %}
            <option value="{{ gb_name }}">{{ gb_label }}</option>
            {% endif %}
            {% endfor %}
          </select>
        </div>
        {% endif %}
        {% if quick_filters %}
        <div class="feretui-quick-filters buttons has-addons" style="margin: 0; display: inline-flex;">
          {% for qf in quick_filters %}
          {% if qf.method == 'delete' %}
          <button
            type="button"
            class="button outline {{ 'is-primary active' if qf.is_active else 'secondary' }} is-small"
            hx-delete="{{ qf.url }}"
            hx-target="#feretui-body"
            hx-swap="innerHTML"
            style="padding: 0.25rem 0.5rem; margin: 0; font-size: 0.85rem;"
            title="{{ qf.label }}"
          >
            {% if qf.icon %}<i class="{{ qf.icon }}"></i>{% endif %}
            <span>{{ qf.label }}</span>
          </button>
          {% else %}
          <button
            type="button"
            class="button outline {{ 'is-primary active' if qf.is_active else 'secondary' }} is-small"
            hx-post="{{ qf.url }}"
            hx-target="#feretui-body"
            hx-swap="innerHTML"
            style="padding: 0.25rem 0.5rem; margin: 0; font-size: 0.85rem;"
            title="{{ qf.label }}"
          >
            {% if qf.icon %}<i class="{{ qf.icon }}"></i>{% endif %}
            <span>{{ qf.label }}</span>
          </button>
          {% endif %}
          {% endfor %}
        </div>
        {% endif %}
      </div>
      <div style="text-align: right;">
        <div class="field is-grouped is-grouped-multiline">
        {% for fname, values in filters if fname != 'search' %}
          <div class="control" style="display: inline-block; margin: 0.25rem;">
            <div class="tags has-addons">
              <span class="tag is-dark">{{ fname }}</span>
              {% for value in values %}
              <span class="tag is-info">
                {{ value }}
                <button
                  class="delete"
                  type="button"
                  hx-delete="{{ feretui.base_url }}/action/resource?action=filters&amp;{{ fname }}={{ value }}"
                  hx-params="none"
                >
                </button>
              </span>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
        </div>
      </div>
    </div>
  </template>
  <template id="view-filter">
    <article class="panel mb-4">
      <header class="panel-heading">
        <strong>Filter</strong>
      </header>
      {% for field in form %}
      <div class="panel-block">
        <div class="container">
        {{ field(**{'hx-post': hx_post, 'hx-params': field.name, 'hx-trigger': "keyup[key=='Enter'],blur"}) }}
        </div>
      </div>
      {% endfor %}
    </article>
  </template>
  <template id="view-export-button">
    <a
      class="button is-secondary is-small outline"
      role="button"
      href="{{ url }}"
      download
    >
      <span class="icon">
        <i class="ti ti-file-export"></i>
      </span>
      <span>Export {{ format.upper() }}</span>
    </a>
  </template>
</templates>
