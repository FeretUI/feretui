<templates>
  <template id="view-goto-create-button">
    <button
      class="button is-primary"
      hx-get="{{ url }}"
    >
      <span class="icon">
        <i class="fa-solid fa-plus"></i>
      </span>
      <span>Create</span>
    </button>
  </template>
  <template id="view-do-save-button">
    <button
      class="button is-primary"
      type="submit"
    >
      <span class="icon">
        <i class="fa-regular fa-pen-to-square"></i>
      </span>
      <span>Save</span>
    </button>
  </template>
  <template id="view-goto-selected-delete-button">
    <button
      class="button is-danger selected-buttons-resource-{{ rcode }}-view-{{ vcode }}"
      hx-post="{{ feretui.base_url }}/action/resource?action=goto_delete"
      disabled="{{ disabled }}"
    >
      <span class="icon">
        <i class="fa-solid fa-trash"></i>
      </span>
      <span>Delete</span>
    </button>
  </template>
  <template id="view-goto-delete-button">
    <button
      class="button is-danger"
      hx-get="{{ url }}"
    >
      <span class="icon">
        <i class="fa-solid fa-trash"></i>
      </span>
      <span>Delete</span>
    </button>
  </template>
  <template id="view-do-delete-button">
    <button
      class="button is-danger"
      type="submit"
    >
      <span class="icon">
        <i class="fa-solid fa-trash"></i>
      </span>
      <span>Delete</span>
    </button>
  </template>
  <template id="view-goto-edit-button">
    <button
      class="button is-primary"
      hx-get="{{ url }}"
    >
      <span class="icon">
        <i class="fa-regular fa-pen-to-square"></i>
      </span>
      <span>Edit</span>
    </button>
  </template>
  <template id="view-goto-return-button">
    <button
      class="button is-ghost secondary outline"
      hx-get="{{ url }}"
    >
      <span class="icon">
        <i class="fa-solid fa-arrow-left"></i>
      </span>
      <span>Return</span>
    </button>
  </template>
  <template id="view-goto-cancel-button">
    <button 
      class="button is-ghost secondary outline"
      type="reset"
      onclick="window.history.back()"
    >
      <span class="icon">
        <i class="fa-solid fa-xmark"></i>
      </span>
      <span>Cancel</span>
    </button>
  </template>
  <template id="view-goto-edit-cancel-button">
    <button 
      class="button is-ghost secondary outline"
      type="reset"
      hx-get="{{ url }}"
    >
      <span class="icon">
        <i class="fa-solid fa-xmark"></i>
      </span>
      <span>Cancel</span>
    </button>
  </template>
  <template id="view-buttons-header">
    <div class="buttons is-centered is-hidden-print">
      {% for button in header_buttons %}
      {{ button }}
      {% endfor %}
    </div>
  </template>
  <template id="view-pagination">
    <div class="is-hidden-print" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 0.75rem;">
      <div style="flex: 0 0 auto;">
        <include template="view-buttons-header" />
      </div>
      <div style="margin-left: auto;">
        {% if paginations %}
        <nav class="pagination" role="navigation" aria-label="pagination">
          <ul class="pagination-list">
            {% for pagination in paginations %}
            <li>
              {% if pagination == offset %}
              <button class="button pagination-link is-current">
                {{ pagination + 1 }}-{{ [pagination + limit, dataset.total]|min }}
                <span class="is-sr-only">Selected</span>
              </button>
              {% endif %}
              {% if pagination != offset %}
              <button
                class="button pagination-link"
                hx-get="{{ feretui.base_url}}/action/resource?action=pagination&amp;offset={{ pagination }}"
              >
                {{ pagination + 1 }}-{{ [pagination + limit, dataset.total]|min }}
              </button>
              {% endif %}
            </li>
            {% endfor %}
          </ul>
          {% if paginations[0] == offset %}
          <button class="button pagination-previous" disabled>
            <i class="fa-solid fa-chevron-left"></i>
          </button>
          {% endif %}
          {% if paginations[0] != offset %}
          <button
            class="button pagination-previous"
            hx-get="{{ feretui.base_url}}/action/resource?action=pagination&amp;offset={{offset - limit}}"
          >
            <i class="fa-solid fa-chevron-left"></i>
            <span class="is-sr-only">Previous</span>
          </button>
          {% endif %}
          {% if paginations[-1] == offset %}
          <button class="button pagination-next" disabled>
            <i class="fa-solid fa-chevron-right"></i>
          </button>
          {% endif %}
          {% if paginations[-1] != offset %}
          <button
            class="button pagination-next"
            hx-get="{{ feretui.base_url}}/action/resource?action=pagination&amp;offset={{offset + limit}}"
          >
            <i class="fa-solid fa-chevron-right"></i>
            <span class="is-sr-only">Next</span>
          </button>
          {% endif %}
        </nav>
        {% endif %}
      </div>
    </div>
  </template>
  <template id="view-multi-header">
    <div class="is-hidden-print" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem;">
      <div>
        <h1>{{ label }} <small>({{ dataset.total }})</small></h1>
      </div>
      <div style="text-align: right;">
        <div class="field is-grouped is-grouped-multiline">
        {% for fname, values in filters %}
          <div class="control" style="display: inline-block; margin: 0.25rem;">
            <div class="tags has-addons">
              <span class="tag is-dark">{{ fname }}</span>
              {% for value in values %}
              <span class="tag is-info">
                {{ value }}
                <button
                  class="delete"
                  type="button"
                  hx-delete="{{ feretui.base_url }}/action/resource?action=filters&amp;{{ fname }}={{ value }}"
                  hx-params="none"
                >
                </button>
              </span>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
        </div>
      </div>
    </div>
  </template>
  <template id="view-filter">
    <article class="panel mb-4">
      <header class="panel-heading">
        <strong>Filter</strong>
      </header>
      {% for field in form %}
      <div class="panel-block">
        <div class="container">
        {{ field(**{'hx-post': hx_post, 'hx-params': field.name, 'hx-trigger': "keyup[key=='Enter'],blur"}) }}
        </div>
      </div>
      {% endfor %}
    </article>
  </template>
</templates>
