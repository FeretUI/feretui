<templates>
  <template id="feretui-page-resource-action">
    <button
      class="button panel-block is-fullwidth outline secondary"
      hx-post="{{ url }}"
    >
      <include template="feretui-icon" />
      <span>{{ label }}</span>
      <include template="feretui-description"/>
    </button>
  </template>
  <template id="feretui-page-resource-action-for-selected-rows">
    <button
      class="button panel-block selected-buttons-resource-{{ rcode }}-view-{{ vcode }} is-fullwidth outline secondary"
      hx-post="{{ url }}"
      disabled
    >
      <include template="feretui-icon" />
      <span>{{ label }}</span>
      <include template="feretui-description"/>
    </button>
  </template>
  <template id="feretui-page-resource-action-set">
    <article class="panel mb-4">
      <header class="panel-heading">
        <include template="feretui-icon" />
        <span>{{ label }}</span>
        <include template="feretui-description"/>
      </header>
      {% for action in actions %}
      {{ action }}
      {% endfor %}
    </article>
  </template>
  <template id="feretui-page-resource-action-open-modal">
    <button
      class="button panel-block is-fullwidth outline secondary"
      type="button"
      hx-get="{{ url }}"
      hx-target="#feretui-modal-stack"
      hx-swap="beforeend"
    >
      <include template="feretui-icon" />
      <span>{{ label }}</span>
      <include template="feretui-description"/>
    </button>
  </template>
  <template id="feretui-page-resource-action-open-modal-for-selected-rows">
    <button
      class="button panel-block selected-buttons-resource-{{ rcode }}-view-{{ vcode }} is-fullwidth outline secondary"
      type="button"
      hx-get="{{ url }}"
      hx-include="closest form"
      hx-target="#feretui-modal-stack"
      hx-swap="beforeend"
      disabled
    >
      <include template="feretui-icon" />
      <span>{{ label }}</span>
      <include template="feretui-description"/>
    </button>
  </template>
</templates>
